# ─── Database ────────────────────────────────────────────────────────────────
# Option A: SQLite (zero-setup, great for local dev)
DATABASE_URL=sqlite+aiosqlite:///./arvyax.db

# Option B: PostgreSQL (production-grade, use with Docker)
# DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5432/arvyax

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3001
